generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                @id @default(uuid())
  email                    String                @unique
  passwordHash             String
  name                     String
  role                     String                @default("LEARNER") // LEARNER, ADMIN
  nativeLanguage           String                @default("hi") // Hindi default
  learningGoal             String                @default("Talk with family & shop confidently")
  accessibilityPreferences String                @default("{\"fontSize\":\"large\",\"highContrast\":false,\"soundSpeed\":\"0.85\"}")
  streakCount              Int                   @default(1)
  totalPoints              Int                   @default(100)
  lastActiveDate           DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  sessions                 ConversationSession[]
  vocabulary               UserVocabulary[]
  auditLogs                AuditLog[]
}

model Scenario {
  id                  String                @id @default(uuid())
  title               String
  titleHindi          String
  slug                String                @unique
  category            String                // DAILY_LIFE, HEALTH, FAMILY, SOCIAL
  description         String
  descriptionHindi    String
  icon                String                @default("MessageCircle")
  characterName       String                @default("Aarti Didi")
  characterNameHindi  String                @default("आरती दीदी")
  promptContext       String
  starterAudioText    String
  starterAudioHindi   String
  orderIndex          Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  sessions            ConversationSession[]
}

model ConversationSession {
  id          String     @id @default(uuid())
  userId      String
  scenarioId  String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario    Scenario   @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  messages    Message[]
}

model Message {
  id                 String              @id @default(uuid())
  sessionId          String
  sender             String              // USER, AI
  text               String
  hindiTranslation   String?             // Tap-to-translate text in Hindi
  correctedSentence  String?             // Non-interruptive gentle grammar polish
  explanationHindi   String?             // Friendly explanation in Hindi
  clarityScore       Int?                // 0 - 100
  createdAt          DateTime            @default(now())

  session            ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model UserVocabulary {
  id              String   @id @default(uuid())
  userId          String
  word            String
  hindiMeaning    String
  phonetic        String?
  exampleSentence String?
  category        String   @default("Everyday")
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String
  ipAddress String?
  userAgent String?
  details   String?
  timestamp DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                @id @default(uuid())
  email                    String                @unique
  passwordHash             String
  name                     String
  role                     String                @default("LEARNER") // LEARNER, ADMIN
  nativeLanguage           String                @default("hi") // Hindi default
  learningGoal             String                @default("Talk with family & shop confidently")
  accessibilityPreferences String                @default("{\"fontSize\":\"large\",\"highContrast\":false,\"soundSpeed\":\"0.85\"}")
  streakCount              Int                   @default(1)
  totalPoints              Int                   @default(100)
  lastActiveDate           DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  sessions                 ConversationSession[]
  vocabulary               UserVocabulary[]
  auditLogs                AuditLog[]
  curriculumProgress       CurriculumProgress[]
  sessionTranscripts       SessionTranscript[]
}

model Scenario {
  id                  String                @id @default(uuid())
  title               String
  titleHindi          String
  slug                String                @unique
  category            String                // DAILY_LIFE, HEALTH, FAMILY, SOCIAL
  difficulty          String                @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED
  description         String
  descriptionHindi    String
  icon                String                @default("MessageCircle")
  characterName       String                @default("Aarti Didi")
  characterNameHindi  String                @default("आरती दीदी")
  promptContext       String
  starterAudioText    String
  starterAudioHindi   String
  orderIndex          Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  sessions            ConversationSession[]
}

model ConversationSession {
  id          String     @id @default(uuid())
  userId      String
  scenarioId  String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario    Scenario   @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  messages    Message[]
}

model Message {
  id                 String              @id @default(uuid())
  sessionId          String
  sender             String              // USER, AI
  text               String
  hindiTranslation   String?             // Tap-to-translate text in Hindi
  correctedSentence  String?             // Non-interruptive gentle grammar polish
  explanationHindi   String?             // Friendly explanation in Hindi
  clarityScore       Int?                // 0 - 100
  createdAt          DateTime            @default(now())

  session            ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model UserVocabulary {
  id              String   @id @default(uuid())
  userId          String
  word            String
  hindiMeaning    String
  phonetic        String?
  exampleSentence String?
  category        String   @default("Everyday")
  difficulty      String   @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String
  ipAddress String?
  userAgent String?
  details   String?
  timestamp DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Lesson {
  id                 String               @id @default(uuid())
  level              String               @default("LEVEL_0") // LEVEL_0, LEVEL_1, LEVEL_2, LEVEL_3
  category           String               // AUXILIARY_VERBS, SUBJECT_VERB_AGREEMENT, SENTENCE_BUILDING, PAST_AUXILIARY
  title              String
  titleHindi         String
  description        String
  descriptionHindi   String
  ruleSummary        String
  ruleSummaryHindi   String
  orderIndex         Int                  @default(0)
  exercises          String               // JSON string of interactive exercises (word ordering, drag-and-drop, was/were/is/am/are fill-ins)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  progress           CurriculumProgress[]
}

model CurriculumProgress {
  id                 String    @id @default(uuid())
  userId             String
  lessonId           String
  level              String    @default("LEVEL_0")
  completed          Boolean   @default(false)
  score              Int       @default(0) // 0-100
  accuracyRate       Float     @default(0.0)
  auxiliaryMastery   String    @default("{}") // JSON tracking counts for is, am, are, was, were
  svoMastery         Int       @default(0) // Correct SVO sentence constructions
  avatarMood         String    @default("encouraging") // encouraging, celebrating, explaining
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson             Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model SessionTranscript {
  id                 String    @id @default(uuid())
  userId             String
  sessionId          String?
  sessionType        String    @default("LEVEL_0_CLASSROOM") // LEVEL_0_CLASSROOM, SCENARIO_CHAT, ORAL_PRACTICE
  avatarState        String    @default("idle") // idle, speaking, listening, cheering, explaining
  userSpeech         String?
  aiPrompt           String?
  aiAudioEmotion     String?   @default("warm") // warm, proud, gentle
  accuracy           Int?
  feedbackHindi      String?
  mistakesJson       String?   // JSON string of diagnosed mistakes
  createdAt          DateTime  @default(now())

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

